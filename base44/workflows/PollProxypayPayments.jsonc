  "name": "Poll Proxypay Payments",
  "description": "Verifica pagamentos Proxypay a cada 5 min como fallback ao webhook \u2014 ativa subscri\u00e7\u00f5es pendentes e faz acknowledge.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "poll_proxypay_payments",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "poll_payments": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pollProxypayPayments",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Verificar pagamentos Proxypay",
