{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "app_role": {
      "type": "string",
      "description": "Papel de acesso aos m\u00f3dulos da aplica\u00e7\u00e3o",
      "enum": [
        "admin",
        "partner",
        "corporate",
        "user"
      ],
      "default": "user"
    },
    "nif": {
      "type": "string",
      "description": "NIF do contribuinte. Necess\u00e1rio para as faturas contarem para a dedu\u00e7\u00e3o do IRPS"
    },
    "phone": {
      "type": "string",
      "description": "N\u00famero de telem\u00f3vel"
    },
    "agt_consent": {
      "type": "boolean",
      "default": false,
      "description": "Consentimento para o feed de fatura\u00e7\u00e3o eletr\u00f3nica da AGT"
    },
    "agt_consent_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data do consentimento AGT"
    },
    "partner_nif": {
      "type": "string",
      "description": "NIF da empresa parceira que este utilizador representa (s\u00f3 relevante quando app_role='partner'). Usado para isolar dados entre parceiros."
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa corporativa deste utilizador (s\u00f3 relevante quando app_role='corporate'). Usado para isolar dados entre empresas no m\u00f3dulo Empresas."
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}