{
  "name": "Approval",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": [
        "payment",
        "invoice",
        "transfer"
      ],
      "description": "Tipo de entidade a aprovar"
    },
    "entity_id": {
      "type": "string",
      "description": "ID da entidade a aprovar"
    },
    "entity_description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o leg\u00edvel da entidade"
    },
    "amount": {
      "type": "number",
      "description": "Montante a aprovar em kwanza"
    },
    "supplier_name": {
      "type": "string",
      "description": "Nome do fornecedor, se aplic\u00e1vel"
    },
    "cost_center_id": {
      "type": "string",
      "description": "Centro de custo associado"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "requested_by_id": {
      "type": "string",
      "description": "ID de quem solicitou"
    },
    "requested_by_name": {
      "type": "string"
    },
    "approved_by_id": {
      "type": "string",
      "description": "ID de quem aprovou/rejeitou"
    },
    "approved_by_name": {
      "type": "string"
    },
    "decision_date": {
      "type": "string",
      "format": "date-time"
    },
    "decision_note": {
      "type": "string",
      "description": "Nota de decis\u00e3o"
    },
    "requires_reason": {
      "type": "boolean",
      "default": false,
      "description": "Se a aprova\u00e7\u00e3o requer motivo justificado"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa propriet\u00e1ria desta aprova\u00e7\u00e3o \u2014 usado para isolar dados entre empresas"
    }
  },
  "required": [
    "entity_type",
    "entity_description",
    "amount",
    "status",
    "company_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}