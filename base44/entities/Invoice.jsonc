{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "issuer_name": {
      "type": "string",
      "description": "Nome do emissor (ENDE, Unitel, etc.)"
    },
    "issuer_nif": {
      "type": "string",
      "description": "NIF do emissor"
    },
    "document_number": {
      "type": "string",
      "description": "N\u00famero do documento"
    },
    "amount": {
      "type": "number",
      "description": "Montante em kwanza"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "mcx_reference",
        "iban",
        "rupe",
        "manual"
      ],
      "description": " M\u00e9todo de pagamento"
    },
    "entity": {
      "type": "string",
      "description": "Entidade Multicaixa Express"
    },
    "reference": {
      "type": "string",
      "description": "Refer\u00eancia Multicaixa Express"
    },
    "iban": {
      "type": "string",
      "description": "IBAN para pagamento por transfer\u00eancia"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "overdue"
      ],
      "default": "pending"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "category_id": {
      "type": "string",
      "description": "Categoria da despesa"
    },
    "has_nif": {
      "type": "boolean",
      "default": true,
      "description": "Se a fatura cont\u00e9m o NIF do contribuinte"
    },
    "deductible_type": {
      "type": "string",
      "enum": [
        "none",
        "saude",
        "educacao",
        "habitacao",
        "pensao_alimentos",
        "previdencia"
      ],
      "default": "none"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "photo_ocr",
        "partner",
        "agt"
      ],
      "default": "manual",
      "description": "Origem da fatura"
    },
    "agt_status": {
      "type": "string",
      "enum": [
        "none",
        "emitted",
        "paid"
      ],
      "default": "none",
      "description": "Estado de verifica\u00e7\u00e3o pela AGT \u2014 s\u00f3 muda com uma confirma\u00e7\u00e3o real da AGT, nunca com a emiss\u00e3o do parceiro nem com o pagamento MCX."
    },
    "user_nif": {
      "type": "string",
      "description": "NIF do contribuinte dono da fatura"
    },
    "partner_emitted": {
      "type": "boolean",
      "default": false,
      "description": "Se esta fatura foi emitida por um parceiro via API (independente de agt_status)"
    },
    "partner_owner_id": {
      "type": "string",
      "description": "ID do utilizador parceiro propriet\u00e1rio da chave de API que emitiu esta fatura \u2014 usado para isolar dados entre parceiros"
    }
  },
  "required": [
    "issuer_name",
    "amount",
    "due_date",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.partner_owner_id": "{{user.id}}"
        },
        {
          "data.user_nif": "{{user.data.nif}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_nif": "{{user.data.nif}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}