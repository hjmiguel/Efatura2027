{
  "name": "Account",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome dado pelo utilizador \u00e0 conta"
    },
    "bank_name": {
      "type": "string",
      "description": "Nome do banco (BFA, BIC, BNI, etc.)"
    },
    "iban": {
      "type": "string",
      "description": "IBAN da conta"
    },
    "balance": {
      "type": "number",
      "description": "Saldo atual em kwanza"
    },
    "type": {
      "type": "string",
      "enum": [
        "checking",
        "savings",
        "cash"
      ],
      "default": "checking"
    },
    "color": {
      "type": "string",
      "description": "Cor de identifica\u00e7\u00e3o da conta"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "bank_name",
    "balance"
  ]
}