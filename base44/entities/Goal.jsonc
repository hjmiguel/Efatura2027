{
  "name": "Goal",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da meta"
    },
    "target": {
      "type": "number",
      "description": "Valor alvo em kwanza"
    },
    "current": {
      "type": "number",
      "default": 0,
      "description": "Valor j\u00e1 poupado"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "description": "Data limite"
    }
  },
  "required": [
    "name",
    "target"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}