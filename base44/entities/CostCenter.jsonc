{
  "name": "CostCenter",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo do centro de custo"
    },
    "name": {
      "type": "string",
      "description": "Nome do centro de custo"
    },
    "budget_monthly": {
      "type": "number",
      "description": "Or\u00e7amento mensal em kwanza"
    },
    "budget_yearly": {
      "type": "number",
      "description": "Or\u00e7amento anual em kwanza"
    },
    "responsible_name": {
      "type": "string",
      "description": "Respons\u00e1vel pelo centro de custo"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa propriet\u00e1ria deste centro de custo \u2014 usado para isolar dados entre empresas"
    }
  },
  "required": [
    "code",
    "name",
    "company_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}