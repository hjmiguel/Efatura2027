{
  "name": "PartnerConsent",
  "type": "object",
  "properties": {
    "partner_name": {
      "type": "string",
      "description": "Nome da empresa parceira"
    },
    "partner_nif": {
      "type": "string",
      "description": "NIF da empresa parceira"
    },
    "user_nif": {
      "type": "string",
      "description": "NIF do utilizador que deu consentimento"
    },
    "consent_status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active"
    },
    "consent_date": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "partner_name",
    "partner_nif",
    "user_nif",
    "consent_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.partner_nif": "{{user.data.partner_nif}}"
        },
        {
          "data.user_nif": "{{user.data.nif}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_nif": "{{user.data.nif}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_nif": "{{user.data.nif}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}