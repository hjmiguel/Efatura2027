{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do fornecedor"
    },
    "nif": {
      "type": "string",
      "description": "NIF do fornecedor"
    },
    "iban": {
      "type": "string",
      "description": "IBAN para pagamento"
    },
    "category": {
      "type": "string",
      "description": "Categoria do fornecedor"
    },
    "payment_terms_days": {
      "type": "number",
      "default": 30,
      "description": "Prazo de pagamento em dias"
    },
    "withholding_rate": {
      "type": "number",
      "default": 6.5,
      "description": "Taxa de reten\u00e7\u00e3o na fonte (%)"
    },
    "applies_withholding": {
      "type": "boolean",
      "default": true,
      "description": "Se aplica reten\u00e7\u00e3o na fonte"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa propriet\u00e1ria deste fornecedor \u2014 usado para isolar dados entre empresas"
    }
  },
  "required": [
    "name",
    "nif",
    "company_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}