{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da categoria"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ]
    },
    "icon": {
      "type": "string",
      "description": "Nome do \u00edcone lucide-react"
    },
    "color": {
      "type": "string",
      "description": "Cor da categoria"
    },
    "is_deductible": {
      "type": "boolean",
      "default": false,
      "description": "Se as despesas nesta categoria s\u00e3o dedut\u00edveis no IRPS"
    },
    "deductible_type": {
      "type": "string",
      "enum": [
        "none",
        "saude",
        "educacao",
        "habitacao",
        "pensao_alimentos",
        "previdencia"
      ],
      "default": "none",
      "description": "Tipo de dedu\u00e7\u00e3o IRPS"
    }
  },
  "required": [
    "name",
    "type"
  ]
}