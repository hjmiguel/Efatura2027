{
  "name": "Dependent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do dependente"
    },
    "relationship": {
      "type": "string",
      "enum": [
        "conjuge",
        "filho",
        "pai",
        "mae",
        "outro"
      ],
      "description": "Grau de parentesco"
    },
    "nif": {
      "type": "string",
      "description": "NIF do dependente"
    },
    "birth_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "name",
    "relationship"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}